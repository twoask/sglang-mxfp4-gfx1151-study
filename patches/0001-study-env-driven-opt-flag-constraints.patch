From 9db5da51638f91b2f4821851096a3fc3c82d6faa Mon Sep 17 00:00:00 2001
From: twoask <twoask@gmail.com>
Date: Sun, 8 Nov 2026 09:14:25 -0800
Subject: [PATCH] scratch: env-driven triton_kernels opt-flag constraints for
 MXFP4 study

---
 python/sglang/srt/layers/quantization/mxfp4.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/python/sglang/srt/layers/quantization/mxfp4.py b/python/sglang/srt/layers/quantization/mxfp4.py
index 1e03c45cf9..dbc4500e0f 100644
--- a/python/sglang/srt/layers/quantization/mxfp4.py
+++ b/python/sglang/srt/layers/quantization/mxfp4.py
@@ -277,6 +277,10 @@ def _swizzle_mxfp4(quant_tensor, scale, num_warps):
         # No scale layout carries the warp count below Hopper, and the tile
         # formula gives the batch-1 decode tile a single warp.
         opt_flags.update_opt_flags_constraints({"num_warps": num_warps})
+    # SCRATCH (not for upstream): A/B tile constraints for the MXFP4 study
+    import json as _json, os as _os
+    if _os.environ.get("MXFP4_STUDY_OGS"):
+        opt_flags.update_opt_flags_constraints(_json.loads(_os.environ["MXFP4_STUDY_OGS"]))
     # transpose the tensor so that the quantization axis is on dim1
     quant_tensor = quant_tensor.transpose(-2, -1)
     scale = scale.transpose(-2, -1)
-- 
2.43.0

